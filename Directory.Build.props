<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- Environment.props is generated by scripts/setup.sh from valheim.env. -->
  <Import Project="$(MSBuildThisFileDirectory)Environment.props"
          Condition="Exists('$(MSBuildThisFileDirectory)Environment.props')" />

  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <LangVersion>latest</LangVersion>
    <!-- Directory.Build.props is imported before the SDK defines its default search
         paths, so $(AssemblySearchPaths) is still empty here. Appending to it would
         silently drop {HintPathFromItem} and every <HintPath> in every mod would be
         ignored. List the tokens explicitly instead. -->
    <AssemblySearchPaths>{CandidateAssemblyFiles};{HintPathFromItem};{TargetFrameworkDirectory};{RawFileName};$(ValheimManaged);$(OutDir)</AssemblySearchPaths>
    <!-- Game assemblies are unsigned and unversioned in the usual sense; quiet the noise. -->
    <NoWarn>$(NoWarn);CS0626;CS0649;MSB3277</NoWarn>
    <DebugType>portable</DebugType>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <Target Name="AssertEnvironment" BeforeTargets="BeforeBuild">
    <Error Condition="'$(ValheimManaged)' == ''"
           Text="Environment.props is missing or empty. Run scripts/setup.sh first." />
    <Error Condition="!Exists('$(ValheimManaged)/assembly_valheim.dll')"
           Text="assembly_valheim.dll not found at $(ValheimManaged). Check valheim.env and re-run scripts/setup.sh." />
  </Target>
</Project>
